# Terraform state files and backups
**/*.tfstate
**/*.tfstate.*
*.tfstate.backup

# Terraform .cache directory
.terraform/

# Crash log files
crash.log

# Exclude all .tfvars files, which may contain sensitive data
# except for an example file
#
# *.tfvars
# !*.tfvars.example

# Module and provider information (might be in .terraform)

# config for vscode plugins
.vscode/

# the assembled site (see scripts/build-sites.sh)
dist/

# frontend test dependencies
node_modules/

# any csv or json files in scripts folder are temporary
scripts/*.csv
scripts/*.json

# Python bytecode (the Lambda folders are zipped as they are, so a stray .pyc would end up in the deployed function)
__pycache__/
*.pyc
